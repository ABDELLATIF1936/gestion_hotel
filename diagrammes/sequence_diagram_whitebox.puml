@startuml
actor "Réceptionniste" as User
participant "ReservationView" as View
participant "ReservationController" as Controller
participant "ReservationService" as Service
participant "ReservationDAO" as DAO
participant "Database" as DB

User -> View : addReservation()
activate View

View -> View : Validate Input()
View -> Controller : createReservation(reservation)
activate Controller

Controller -> Service : createReservation(reservation)
activate Service

Service -> Service : validateDates()
Service -> DAO : isRoomAvailable(chambre, dates)
activate DAO
DAO -> DB : SELECT usage
DB --> DAO : result
DAO --> Service : boolean
deactivate DAO

alt Room Not Available
    Service --> Controller : throw ServiceException
    deactivate Service
    Controller --> View : Error Message
    deactivate Controller
    View --> User : Show Error
else Room Available
    Service -> DAO : create(reservation)
    activate DAO
    DAO -> DB : INSERT reservation
    DB --> DAO : Generated ID
    DAO --> Service : ID
    deactivate DAO
    
    Service --> Controller : Created Reservation
    deactivate Service

    Controller --> View : Reservation Object
    deactivate Controller

    View -> View : clearForm()
    View -> View : loadReservations()
    View --> User : Success Message
end

deactivate View
@enduml
