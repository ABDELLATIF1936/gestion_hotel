@startuml
actor User
participant "LoginView" as View
participant "LoginController" as Controller
participant "AuthenticationService" as AuthService
participant "UtilisateurDAO" as DAO
participant "Database" as DB

User -> View : Saisir username/password
User -> View : Click "Se connecter"
activate View

View -> Controller : login(username, password)
activate Controller

Controller -> AuthService : authenticate(username, password)
activate AuthService

AuthService -> DAO : findByUsername(username)
activate DAO
DAO -> DB : SELECT * FROM utilisateur WHERE username=?
DB --> DAO : ResultSet (Utilisateur)
DAO --> AuthService : Utilisateur (hash, salt)
deactivate DAO

AuthService -> AuthService : verifyPassword(password, hash)
alt Password Invalid
    AuthService --> Controller : throw AuthenticationException
    deactivate AuthService
    Controller --> View : Show Error "Identifiants invalides"
    deactivate Controller
    View --> User : Message Erreur
else Password Valid
    AuthService -> AuthService : Check Active Status
    
    AuthService --> Controller : Utilisateur (Logged In)
    deactivate AuthService
    
    Controller -> Controller : loadMainView(role)
    Controller --> View : Success
    deactivate Controller
    
    View -> View : close()
    View -> "MainView" : show()
end

deactivate View
@enduml
