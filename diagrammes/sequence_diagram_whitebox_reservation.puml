@startuml
skinparam sequenceMessageAlign center

actor "Réceptionniste" as User
participant "ReservationView" as View
participant "ReservationController" as Ctrl
participant "ReservationService" as Service
participant "ChambreService" as RoomService
participant "ReservationDAO" as DAO
participant "Database" as DB

User -> View : Submit Reservation Form
activate View

View -> Ctrl : createReservation(res)
activate Ctrl

Ctrl -> Service : createReservation(res)
activate Service

' Validation disponibilité
Service -> RoomService : isAvailable(room, dates)
activate RoomService
RoomService -> DB : Check overlap
activate DB
DB --> RoomService : boolean
deactivate DB
RoomService --> Service : true/false
deactivate RoomService

alt Room Available
    Service -> DAO : save(res)
    activate DAO
    DAO -> DB : INSERT INTO reservation
    activate DB
    DB --> DAO : Generated ID
    deactivate DB
    DAO --> Service : res (with ID)
    deactivate DAO
    
    Service --> Ctrl : res
    Ctrl --> View : Success
    View --> User : Show Confirmation
else Room Occupied
    Service --> Ctrl : throw Exception
    deactivate Service
    Ctrl --> View : Error
    deactivate Ctrl
    View --> User : Show "Room Unavailable"
end

deactivate View
@enduml
