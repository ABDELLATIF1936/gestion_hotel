@startuml
node "Poste Client (Réception/Admin)" as ClientNode {
    component "Application JavaFX" as App {
        [Vues (UI)]
        [Contrôleurs]
    }
    component "JRE 17+"
}

node "Serveur de Base de Données" as DbNode {
    database "MySQL 8.0" as DB {
        [gestion_hotel Schema]
    }
}

node "Système de Fichiers" as FileSystem {
    folder "Logs"
    folder "Exports PDF"
}

ClientNode -- DbNode : JDBC (TCP/IP 3306)
App -- FileSystem : I/O (Read/Write)
App ..> "JRE 17+" : Runs on

note right of ClientNode
  Windows 10/11
  Resol: 1920x1080
end note

@enduml
