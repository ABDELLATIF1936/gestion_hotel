@startuml
skinparam actorStyle awesome
hide footbox

actor "Utilisateur" as User
participant ":Système" as System

User -> System : Saisir identifiants (username, password)
activate System
System -> System : Vérifier crédentials

alt Identifiants valides
    System -> System : Charger profil et permissions
    System --> User : Afficher Dashboard
else Identifiants invalides
    System --> User : Afficher message d'erreur
end
deactivate System

@enduml
