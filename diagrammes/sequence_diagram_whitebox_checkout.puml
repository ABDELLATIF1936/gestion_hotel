@startuml
skinparam sequenceMessageAlign center

actor "Réceptionniste" as User
participant "FacturationView" as View
participant "FacturationController" as Ctrl
participant "FactureService" as Service
participant "PdfService" as Pdf
participant "FactureDAO" as DAO
participant "Database" as DB

' Checkout Flow
User -> View : Click "Générer Facture"
activate View
View -> Ctrl : generateFacture(reservationId)
activate Ctrl

Ctrl -> Service : createFacture(reservationId)
activate Service
Service -> Service : calculateTotal()
Service -> DAO : save(facture)
activate DAO
DAO -> DB : INSERT invoice
DB --> DAO : ID
deactivate DAO
Service --> Ctrl : Facture
deactivate Service

' PDF Generation Flow
Ctrl -> Pdf : generateInvoicePdf(facture, path)
activate Pdf
Pdf -> Pdf : buildDocument()
Pdf -> FileSystem : write(file.pdf)
Pdf --> Ctrl : void
deactivate Pdf

Ctrl --> View : Success
deactivate Ctrl
View --> User : "Facture PDF générée"
deactivate View

@enduml
