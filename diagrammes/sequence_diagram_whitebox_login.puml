@startuml
skinparam sequenceMessageAlign center

actor User
participant "LoginView" as View
participant "LoginController" as Controller
participant "AuthenticationService" as Service
participant "UtilisateurDAO" as DAO
participant "Database" as DB

User -> View : Click "Se connecter"
activate View
View -> Controller : login(user, pass)
activate Controller

Controller -> Service : authenticate(user, pass)
activate Service

Service -> DAO : findByUsername(user)
activate DAO
DAO -> DB : SELECT * FROM utilisateur
activate DB
DB --> DAO : ResultSet
deactivate DB
DAO --> Service : User object
deactivate DAO

Service -> Service : verifyPassword(pass, hash)

alt Valid Password
    Service --> Controller : User (Authenticated)
    Controller -> Controller : openDashboard()
    Controller --> View : Success
else Invalid Password
    Service --> Controller : throw AuthException
    deactivate Service
    Controller --> View : Error Message
    deactivate Controller
    View --> User : Show "Login Failed"
end

deactivate View
@enduml
