@startuml
start
:Réceptionniste se connecte;
:Ouvre la vue Réservation;
:Clique sur "Ajouter Réservation";

partition "Processus de Réservation" {
    :Saisir ID Client;
    :Sélectionner Chambre;
    :Choisir Dates (Début/Fin);
    
    if (Chambre disponible ?) then (Non)
        :Afficher erreur "Indisponible";
        stop
    else (Oui)
        :Saisir Nombre de personnes;
        :Choisir Services Supplémentaires (Optionnel);
        note right: Filtre uniquement les services Actifs
        
        :Valider le formulaire;
        
        if (Données valides ?) then (Non)
            :Afficher message d'erreur;
            stop
        else (Oui)
            :Créer Réservation (En Attente);
            :Calculer Coût estimé;
        endif
    endif
}

:Afficher confirmation;
stop
@enduml
