@startuml
package "Client Layer (View)" {
    [MainView]
    [ReservationView]
    [LoginView]
}

package "Controller Layer" {
    [ReservationController]
    [LoginController] 
    [EmployeController]
}

package "Service Layer (Business Logic)" {
    [ReservationService]
    [AuthenticationService]
    [EmployeService]
    interface "IService"
}

package "Data Access Layer (DAO)" {
    [ReservationDAO]
    [UtilisateurDAO]
    [EmployeDAO]
    interface "IDAO"
}

database "MySQL Database" as DB

[MainView] ..> [ReservationController]
[MainView] ..> [LoginController]

[ReservationController] ..> [ReservationService]
[LoginController] ..> [AuthenticationService]

[ReservationService] ..> [ReservationDAO]
[AuthenticationService] ..> [UtilisateurDAO]

[ReservationDAO] ..> DB : JDBC
[UtilisateurDAO] ..> DB : JDBC

@enduml
